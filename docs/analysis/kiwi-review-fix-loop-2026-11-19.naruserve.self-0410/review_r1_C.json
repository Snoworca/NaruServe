 "findings": [
  {
   "id": "C-001",
   "axis": "P7",
   "verdict": "drop",
   "evidence": {
    "command": "cd /Users/beom/work/git/NaruServe && ./gradlew -PtinyHttpdFromMaven=true :NaruServe-proxy:test --tests 'com.snoworca.naruserve.proxy.ReviewProbeRawBackendCloseTest' --console=plain",
    "output": "ReviewProbeRawBackendCloseTest > aClientThatNeverClosesIsIndistinguishableFromOneThatDoes FAILED: java.lang.AssertionError: RawBackend closed the connection itself after 41 response bytes although the client never closed it; requestCount=1, so a proxy that leaks retried connections passes the test",
    "intent_output": "Design note of FR-PROXY-018 (22.reverse-proxy.srs.md:2062): 'Read and discard the header block of a retried 502 or 503 and close its connection before waiting.' That intent is checked elsewhere: ProxyRetryTest#fr_PROXY_018_AC2_theConnectionOfARetried503IsClosedByTheProxy (line 533) and #fr_PROXY_018_AC9_theConnectionOfARetried503IsClosedBeforeTheWait use ConnectionBackend.closedByProxy with a keep-alive 503.",
    "probe_file": "docs/analysis/kiwi-review-fix-loop-2026-11-19.naruserve.self-0410/probes/ReviewProbeRawBackendCloseTest.java",
    "probe_dest": "NaruServe-proxy/src/test/java/com/snoworca/naruserve/proxy/ReviewProbeRawBackendCloseTest.java"
   },
   "drop_reason": "The probe is red: RawBackend closes every connection itself, so this test cannot see whether the proxy closes a retried connection. Two other tests in the same class already check that close with a keep-alive backend, so no intent goes unchecked. What is left is a test name that claims more than its assertions check.",
   "title": "retriesKeepTheOneSlotAndCloseEveryRetriedConnection cannot observe the close its name claims",
   "location": {
    "file": "NaruServe-proxy/src/test/java/com/snoworca/naruserve/proxy/ProxyRetryTest.java",
    "line_range": "154-171"
   },
   "description": "The only oracle is RawBackend.requestCount(). RawBackend's acceptLoop closes each socket itself (try-with-resources) right after it writes the response, so a proxy that never closed the retried connections would still pass this test.",
   "suggested_fix": "Rename the test to its slot claim, or point its comment at the ConnectionBackend tests that check the close.",
   "is_behavioral": false,
   "tags": [
    "test-quality",
    "naming"
   ],
   "family": "test oracle blind to proxy-side close",
   "req_hint": "FR-PROXY-018 AC-2"
  },
  {
   "id": "C-002",
   "axis": "P7",
   "verdict": "drop",
   "evidence": {
    "command": "cd /Users/beom/work/git/NaruServe && ./gradlew -PtinyHttpdFromMaven=true :NaruServe-proxy:test --tests 'com.snoworca.naruserve.proxy.ReviewProbeChunkedRawLimitReachTest' --console=plain",
    "output": "ReviewProbeChunkedRawLimitReachTest > chunkedOverTheRawLimitDoesNotReachTheBackend FAILED: java.lang.AssertionError: backend connections (bytes received: ) expected:<0> but was:<1>; stdout: INFO POST /api/orders/x 413 9ms in=9 ... PROBE accepted=1 received=",
    "intent_output": "FR-PROXY-008 AC-3 (22.reverse-proxy.srs.md:1018): a chunked body that passes the limit while being forwarded makes the proxy close the backend connection. So opening a connection is expected for a chunked overrun.",
    "probe_file": "docs/analysis/kiwi-review-fix-loop-2026-11-19.naruserve.self-0410/probes/ReviewProbeChunkedRawLimitReachTest.java",
    "probe_dest": "NaruServe-proxy/src/test/java/com/snoworca/naruserve/proxy/ReviewProbeChunkedRawLimitReachTest.java"
   },
   "drop_reason": "The proxy does open a TCP connection, but it sends 0 bytes on it. That matches the test's assertion message ('the backend saw no request') and is what the spec allows (FR-PROXY-008 AC-3). Only the test name 'WithoutReachingTheBackend' overstates. RawBackend.requestCount() counts only requests whose body ended, so it could also miss a partly sent request, but no such case was shown here.",
   "title": "chunkedClientBodyOverTheRawLimitGives413WithoutReachingTheBackend: a backend connection is opened",
   "location": {
    "file": "NaruServe-proxy/src/test/java/com/snoworca/naruserve/proxy/ProxyApiTest.java",
    "line_range": "279-294"
   },
   "description": "With rawBodyLimit(8) and a chunked 64-byte body, the proxy connects to the backend and then closes the connection without sending a byte. RawBackend.requestCount() stays 0 because it counts only requests whose head and body were read to the end.",
   "suggested_fix": "Optional: name the test '...WithoutSendingARequest', or count accepted connections if 'no connection' is what is meant.",
   "is_behavioral": false,
   "tags": [
    "test-quality",
    "naming"
   ],
   "family": "RawBackend counts only complete requests",
   "req_hint": "IR-PROXY-001 AC-1, FR-PROXY-008 AC-3"
  }
 ],
