@@ -144,0 +145,14 @@ public final class ReadmeDocsTest {
+    /**
+     * The module table rows of {@code docs/api/README.md}, in order, as {@code {module name, group:artifactId}}; unlike
+     * {@link #apiModuleTable(String)} a repeated coordinate stays as its own row.
+     */
+    static List<String[]> apiModuleRows(String path) throws IOException {
+        List<String[]> rows = new ArrayList<>();
+        Matcher row = Pattern.compile("(?m)^\\| `([\\w-]+)` \\| `(com\\.snoworca\\.naruserve:[\\w-]+)` \\|")
+                .matcher(read(path));
+        while (row.find()) {
+            rows.add(new String[] {row.group(1), row.group(2)});
+        }
+        return rows;
+    }
+
@@ -166,0 +181,10 @@ public final class ReadmeDocsTest {
+        // OPS-DX-011 AC-5: count the rows themselves, so a row that invents a module name but repeats a published
+        // artifactId fails here: eleven rows, no coordinate twice, and each artifactId is its module name in lower case
+        List<String[]> rows = apiModuleRows("docs/api/README.md");
+        assertEquals("rows (not distinct coordinates) of the module table of docs/api/README.md", 11, rows.size());
+        Set<String> coordinates = new TreeSet<>();
+        for (String[] r : rows) {
+            assertTrue("module table coordinate " + r[1] + " appears once", coordinates.add(r[1]));
+            assertEquals("artifactId of the module table row " + r[0], "com.snoworca.naruserve:" + r[0].toLowerCase(Locale.ROOT),
