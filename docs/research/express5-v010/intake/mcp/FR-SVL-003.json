  "value": {
    "id": "FR-SVL-003",
    "title": "Servlet response writing: commit, finish, abort, sendFile and a single start per exchange",
    "type": "functional",
    "target": "wave-8",
    "status": "verified",
    "scope": "SVL",
    "filePath": "docs/spec/14.servlet-adapter.srs.md",
    "headingLine": 411,
    "metadata": {
      "Type": "functional",
