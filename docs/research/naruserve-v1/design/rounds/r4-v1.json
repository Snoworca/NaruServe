 "findings": [
  {
   "finding_id": "V1-001",
   "severity": "medium",
   "kind": "design-gap",
   "items": [
    "D-341",
    "D-401",
    "D-162",
    "D-343"
   ],
   "claim": "No item fixes the shutdown phase in which NaruServe closes open SSE streams. Because D-335 writes SSE as an ordinary chunked response on the worker, TinyHttpd's stop() does not close these streams: onServerStopping closes only TinyHttpd's own SseStream and upgraded connections, and stop() then waits until the grace deadline. If wave 7 registers SSE closing as a force-close participant (after the adapter stop), any shutdown with an open SSE stream lasts the full timeout and clients get no close notice first. That goes against object.md §11.4 step 3, which says to notify SSE/WS while short requests drain.",
   "evidence": "/Users/beom/work/git/TinyHttpd/core/src/main/java/com/snoworca/tinyhttpd/server/Connection.java:508; /Users/beom/work/git/TinyHttpd/core/src/main/java/com/snoworca/tinyhttpd/server/HttpServer.java:471; object.md:753",
   "suggested_fix": "State in D-401/D-341 that SSE closing (ending the drain loop and running onClose) is a before-wait participant, so the adapter stop only waits for short HTTP exchanges."
  },
  {
   "finding_id": "V1-002",
   "severity": "medium",
   "kind": "design-gap",
   "items": [
    "D-435",
    "D-344",
    "D-417"
   ],
   "claim": "D-435 aborts, once, only sessions whose sender-executor write has been in flight for more than 1 s. Two cases still block TinyHttpd's stop thread. First, TinyHttpd's read thread writes Ping (keepalive) and Pong frames under the same writeLock, outside the sender executor. Second, a write that is under 1 s old at check time can then stall. TinyHttpd's stop() calls fireStop, which does close(1001) under writeLock, for every upgraded connection before its grace loop and outside the deadline. So one such stalled session holds shutdown until the 30 s write timeout, which breaks the timeout-plus-margin bound of D-344/T44.",
   "evidence": "/Users/beom/work/git/TinyHttpd/websocket/src/main/java/com/snoworca/tinyhttpd/websocket/WebSocket.java:190; /Users/beom/work/git/TinyHttpd/websocket/src/main/java/com/snoworca/tinyhttpd/websocket/WebSocket.java:288; /Users/beom/work/git/TinyHttpd/websocket/src/main/java/com/snoworca/tinyhttpd/websocket/WebSocket.java:360; /Users/beom/work/git/TinyHttpd/core/src/main/java/com/snoworca/tinyhttpd/server/HttpServer.java:469",
   "suggested_fix": "Have the D-435 ResponseWrapper return a wrapping UpgradedConnection whose OutputStream records write start for every writer, read thread included. Make the before-wait participant abort every session that has any write in flight (no 1 s threshold), or keep a watchdog running until the adapter stop's onServerStopping loop has passed."
  },
  {
   "finding_id": "V1-003",
   "severity": "low",
   "kind": "contradicts-existing-doc-example",
   "items": [
    "D-431",
    "D-349",
    "D-351"
   ],
   "claim": "D-431 makes req.body(Class/TypeRef) @Nullable, so in Kotlin it returns T?. The kotlin.md example `val body = req.body(CreateUserRequest::class.java); val name = body.name` then no longer compiles, yet D-349 requires every docs/api Kotlin example to compile and run as a test. D-192 lists kotlin.md for update but names no example rewrite.",
   "evidence": "docs/api/kotlin.md:140; docs/api/kotlin.md:141; docs/api/kotlin.md:74",
   "suggested_fix": "Have wave 5 rewrite the Kotlin examples that dereference req.body(...) (safe call, or the D-354 reified extension) when it applies D-431, and set the kotlin.md nullability row to T?."
  }
 ],
 "roll_up": "GAPS"
